    <view x="315" wrappingAllowedX="true" y="10" frameRate="1000.0" minPycor="-10" height="434" showTickCounter="true" patchSize="20.24" fontSize="10" wrappingAllowedY="true" width="433" tickCounterLabel="attempted flips" maxPycor="10" updateMode="1" maxPxcor="10" minPxcor="-10"></view>
