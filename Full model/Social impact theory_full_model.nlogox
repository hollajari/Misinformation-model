  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="400000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>magnetization</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="max-h">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="probability-of-spin-up">
          <value value="50"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="15Oct_A&amp;C" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= 25000]]></exitCondition>
      <metrics>
        <metric>ticks</metric>
        <metric>last-flip-tick</metric>
        <metric>stable?</metric>
        <metric>outcome</metric>
        <metric>initial-fraction</metric>
        <metric>frac-believing</metric>
        <metric>magnetization</metric>
        <metric>total-flips</metric>
        <metric>persistent-fraction</metric>
        <metric>interface-density</metric>
        <metric>cluster-count</metric>
        <metric>largest-cluster-fraction</metric>
        <metric>largest-believer-cluster-fraction</metric>
        <metric>initial-clusters</metric>
        <metric>initial-largest</metric>
        <metric>count patches</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="mean-init-A" first="0" step="0.2" last="1"></steppedValueSet>
        <enumeratedValueSet variable="sd-init-A">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="gamma">
          <value value="10"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="probability-of-convergence" first="0" step="20" last="100"></steppedValueSet>
        <enumeratedValueSet variable="delta">
          <value value="10"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max-h">
