    <monitor x="100" precision="3" y="115" height="45" fontSize="11" display="magnetization" width="114" sizeVersion="0">magnetization</monitor>
    <plot x="10" autoPlotX="true" yMax="1.0" autoPlotY="true" yAxis="average spin" y="165" xMin="0.0" height="280" legend="false" xMax="20.0" yMin="-1.0" xAxis="time" display="Magnetization" width="296" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="average spin" color="-13345367" legend="true">
        <setup></setup>
