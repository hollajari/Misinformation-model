<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [
  sum-of-spins   ;; sum of all the spins (agents believing in misinformation)
  last-flip-tick 
  total-flips 
  n-clusters 
  largest-cluster 
  initial-largest
]


patches-own [
  spin           ;; holds -1 or 1
  persuasiveness
  supportiveness
  A ;; Analytical thinking
  C ;; Congruence with the misinformation (i.e., does the misinformation support or go against ones own belief system)
  alpha ;; Individual susceptibility to distant information/persuasion (= 1 / alpha)
  
  ever-flipped?
  cluster-id
]

to setup
  clear-all
  ask patches [
    ifelse random 100 < probability-of-spin-up
      [ set spin  1 ]
      [ set spin -1 ]
    recolor
  ]
  ask patches [
   set persuasiveness  random 100
   set supportiveness  random 100
   set A max list 0 (random-normal mean-init-A sd-init-A) ;; randomly generate values for individual Analytical thinking, limited to positive values
   set alpha max list 1 (random-normal mean-init-alpha sd-init-alpha) ;; randomly generate values for a (influence of distance), limited to positive values
   set ever-flipped? false 
    ifelse random 100 < probability-of-convergence 
      [ set C  1 ]
      [ set C -1 ]
  ]

  set sum-of-spins sum [ spin ] of patches
  
  set last-flip-tick 0
  set total-flips 0
  find-clusters
  set initial-largest largest-cluster
  
  reset-ticks
end

to go

  repeat 100 [
    tick-advance 1
    ask one-of patches [ update ]
  ]
  find-clusters  
  update-plots

end
  
to update  ;; patch procedure, called as: ask one-of patches [ update ]
  let px pxcor
  let py pycor
  let p spin
  let my-alpha alpha

  let SIs sum [ 2 * supportiveness / ((distancexy px py) ^ my-alpha) ] of other patches with [ spin = p ]
  let SIp sum [ 2 * persuasiveness / ((distancexy px py) ^ my-alpha) ] of other patches with [ spin != p ]

  let field (p * (SIs - SIp)) - (gamma * A) + (delta * C) - (H / my-alpha)  
  if field > 0 [ set spin 1 ]
  if field < 0 [ set spin -1 ]                   ;; field = 0: keep current opinion

  if spin != p [
    set sum-of-spins sum-of-spins + 2 * spin
    set total-flips total-flips + 1
    set last-flip-tick ticks
    set ever-flipped? true
  ]
  
  recolor
end

;; color the patches according to their spin
to recolor  ;; patch procedure
  ifelse spin = 1
    [ set pcolor red + 2 ]
    [ set pcolor blue - 2 ]
end

;; a measure of magnetization, the average of the spins
to-report magnetization
  report sum-of-spins / count patches
end

to-report frac-believing
  report (1 + magnetization) / 2
end

to find-clusters
  ask patches [ set cluster-id -1 ]
  set n-clusters 0
  set largest-cluster 0
  ask patches [
    if cluster-id = -1 [
      let my-spin spin
      let members (patch-set self)
      let frontier (patch-set self)
      set cluster-id n-clusters
      while [ any? frontier ] [
        let new-patches (patch-set [ neighbors4 ] of frontier) with [ cluster-id = -1 and spin = my-spin ]
        ask new-patches [ set cluster-id n-clusters ]
        set members (patch-set members new-patches)
        set frontier new-patches
      ]
      let cluster-size count members
      set largest-cluster max (list largest-cluster cluster-size)
      set n-clusters n-clusters + 1
    ]
  ]
end

to-report largest-cluster-fraction
  report largest-cluster / count patches
end

to-report persistent-fraction
  report (count patches with [ not ever-flipped? ]) / count patches
end

to-report interface-density
  let directed-links sum [ count neighbors4 ] of patches
  if directed-links = 0 [ report 0 ]

  let disagreements sum [
    count neighbors4 with [ spin != [spin] of myself ]
  ] of patches

  report disagreements / directed-links
end]]></code>
